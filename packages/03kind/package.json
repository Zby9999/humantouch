{
  "name": "03kind",
  "version": "0.0.0",
  "description": "An editor layer for your project's local dev server: edit the page itself, visually, on a canvas, then have your Agent write the changes into the code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zby9999/03kind.git",
    "directory": "packages/03kind"
  },
  "type": "module",
  "files": [
    "dist",
    "skill"
  ],
  "bin": {
    "03kind": "./dist/cli.js"
  },
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    },
    "./next-loader": "./dist/next-loader.cjs",
    "./react": {
      "types": "./dist/react.d.ts",
      "development": "./dist/react.dev.js",
      "default": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node -e \"for (const file of ['README.md', 'LICENSE']) require('node:fs').copyFileSync('../../' + file, file)\"",
    "postpack": "node -e \"for (const file of ['README.md', 'LICENSE']) require('node:fs').rmSync(file, { force: true })\""
  },
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "magic-string": "^1.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@vitest/browser-playwright": "5.0.4",
    "playwright": "1.64.1",
    "preact": "^11.0.1",
    "react": "^19.3.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "vite": ">=5",
    "next": ">=16"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  }
}
