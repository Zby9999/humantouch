{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    // The bench runs under Node itself, which strips the types and imports each file by its own name.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["."]
}
